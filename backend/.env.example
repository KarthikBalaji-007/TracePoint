# TracePoint Backend — Production Environment Template
# Note: Never commit production secret keys or credentials to version control.

# Comma-separated list of allowed frontend origins for CORS
# In production, set to your Vercel or public frontend URL(s).
# Example: https://tracepoint.vercel.app,https://tracepoint-preview.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tracepoint.vercel.app

# Server Port (assigned dynamically by platforms like Render, Fly.io, or Heroku via $PORT)
PORT=8000
HOST=0.0.0.0

# SQLite Persistence Path
# Optional: Set to persistent volume mount path if deploying to a container with disk volume (e.g., /data/tracepoint.sqlite3)
# If left unset, defaults to backend/data/tracepoint.sqlite3
TRACEPOINT_DATABASE_PATH=backend/data/tracepoint.sqlite3

# ML Artifact Paths (Optional: defaults to repository paths ml/artifacts and ml/data/zones.json)
# TRACEPOINT_ARTIFACT_DIR=ml/artifacts
# TRACEPOINT_ZONE_CATALOGUE=ml/data/zones.json
